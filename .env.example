# Copy to .env. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

PROMPTBENCH_DATABASE_URL=sqlite+aiosqlite:///./data/promptbench.db
PROMPTBENCH_DEFAULT_JUDGE_MODEL=
PROMPTBENCH_REQUEST_TIMEOUT_SECONDS=60
PROMPTBENCH_MAX_RETRIES=2
PROMPTBENCH_MAX_CONCURRENCY=5
PROMPTBENCH_LOG_PROMPTS=false
